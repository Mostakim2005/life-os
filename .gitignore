# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js or runtime chunks in the repo.
# They should be uploaded to GitHub releases instead.
main.js
*.chunk.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Allow live runtime bundle
!runtime/
!runtime/**

# Local reference source code for feasibility analysis (never committed)
_reference-plugins/
